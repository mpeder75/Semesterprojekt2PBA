{
  "AllowedHosts": "localhost",
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ReverseProxy": {
    "Routes": {
      "api-login": {
        "ClusterId": "monolith-api",
        "Order": -10,
        "Timeout": "00:00:30",
        "RateLimiterPolicy": "login",
        "Match": {
          "Path": "/api/authenticate",
          "Methods": [ "POST" ]
        },
        "Transforms": [
          { "RequestHeaderOriginalHost": "true" }
        ]
      },
      "web-login": {
        "ClusterId": "monolith-web",
        "Order": -10,
        "Timeout": "00:00:30",
        "RateLimiterPolicy": "login",
        "Match": {
          "Path": "/Identity/Account/Login",
          "Methods": [ "POST" ]
        },
        "Transforms": [
          { "RequestHeaderOriginalHost": "true" }
        ]
      },
      "public-api": {
        "ClusterId": "monolith-api",
        "Order": 0,
        "Timeout": "00:00:30",
        "RateLimiterPolicy": "api",
        "Match": { "Path": "/api/{**remainder}" },
        "Transforms": [
          { "RequestHeaderOriginalHost": "true" }
        ]
      },
      "public-api-swagger": {
        "ClusterId": "monolith-api",
        "Order": 0,
        "Match": { "Path": "/swagger/{**remainder}" },
        "Transforms": [ { "RequestHeaderOriginalHost": "true" } ]
      },
      "web": {
        "ClusterId": "monolith-web",
        "Order": 100,
        "Match": { "Path": "/{**remainder}" },
        "Transforms": [ { "RequestHeaderOriginalHost": "true" } ]
      }
    },
    "Clusters": {
      "monolith-api": {
        "Destinations": {
          "local": { "Address": "https://localhost:5099/" }
        }
      },
      "monolith-web": {
        "Destinations": {
          "local": { "Address": "https://localhost:5001/" }
        }
      }
    }
  }
}
