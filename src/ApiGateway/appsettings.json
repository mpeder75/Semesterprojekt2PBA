{
  "AllowedHosts": "localhost",
  "FeatureManagement": {
    "UseCatalogService": false,
    "UseBasketService": false,
    "UseOrderService": false
  },

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ReverseProxy": {
    "Routes": {
      "api-login": {
        "ClusterId": "monolith-api",
        "Order": -10,
        "Timeout": "00:02:00",
        "RateLimiterPolicy": "login",
        "Match": {
          "Path": "/api/authenticate",
          "Methods": [ "POST" ]
        },
        "Transforms": [
          { "RequestHeaderOriginalHost": "true" }
        ]
      },
      "web-login": {
        "ClusterId": "monolith-web",
        "Order": -10,
        "Timeout": "00:02:00",
        "RateLimiterPolicy": "login",
        "Match": {
          "Path": "/Identity/Account/Login",
          "Methods": [ "POST" ]
        },
        "Transforms": [
          { "RequestHeaderOriginalHost": "true" }
        ]
      },
      "catalog-items": {
        "ClusterId": "catalog-service",
        "Metadata": {
          "Service": "Catalog"
        },
        "Order": -5,
        "Timeout": "00:02:00",
        "RateLimiterPolicy": "api",
        "Match": { "Path": "/api/catalog-items/{**remainder}" },
        "Transforms": [ { "RequestHeaderOriginalHost": "true" } ]
      },
      "catalog-brands": {
        "ClusterId": "catalog-service",
        "Metadata": {
          "Service": "Catalog"
        },
        "Order": -5,
        "Timeout": "00:02:00",
        "RateLimiterPolicy": "api",
        "Match": { "Path": "/api/catalog-brands/{**remainder}" },
        "Transforms": [ { "RequestHeaderOriginalHost": "true" } ]
      },
      "catalog-types": {
        "ClusterId": "catalog-service",
        "Metadata": {
          "Service": "Catalog"
        },
        "Order": -5,
        "Timeout": "00:02:00",
        "RateLimiterPolicy": "api",
        "Match": { "Path": "/api/catalog-types/{**remainder}" },
        "Transforms": [ { "RequestHeaderOriginalHost": "true" } ]
      },
      "order-api": {
        "ClusterId": "order-service",
        "Metadata": {
          "Service": "Order"
        },
        "Order": -5,
        "Timeout": "00:02:00",
        "RateLimiterPolicy": "api",
        "Match": { "Path": "/api/orders/{**remainder}" },
        "Transforms": [
          { "RequestHeaderOriginalHost": "true" }
        ]
      },
      "basket-api": {
        "ClusterId": "basket-service",
        "Metadata": {
          "Service": "Basket"
        },
        "Order": -5,
        "Timeout": "00:02:00",
        "RateLimiterPolicy": "api",
        "Match": { "Path": "/api/baskets/{**remainder}" },
        "Transforms": [
          { "PathRemovePrefix": "/api/baskets" },
          { "PathPrefix": "/basket" },
          { "RequestHeaderOriginalHost": "true" }
        ]
      },
      "public-api": {
        "ClusterId": "monolith-api",
        "Order": 0,
        "Timeout": "00:02:00",
        "RateLimiterPolicy": "api",
        "Match": { "Path": "/api/{**remainder}" },
        "Transforms": [
          { "RequestHeaderOriginalHost": "true" }
        ]
      },
      "public-api-swagger": {
        "ClusterId": "monolith-api",
        "Order": 0,
        "Match": { "Path": "/swagger/{**remainder}" },
        "Transforms": [ { "RequestHeaderOriginalHost": "true" } ]
      },
      "web": {
        "ClusterId": "monolith-web",
        "Order": 100,
        "Match": { "Path": "/{**remainder}" },
        "Transforms": [ { "RequestHeaderOriginalHost": "true" } ]
      }
    }
  }
}
